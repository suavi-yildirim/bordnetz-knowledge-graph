@prefix bn: <https://example.org/bordnetz#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/bordnetz> a owl:Ontology ;
    rdfs:label "Mini-Ontologie Bordnetz (Demo)"@de,
        "Mini wire-harness ontology (demo)"@en .

bn:Actuator a owl:Class ;
    rdfs:label "Aktor"@de,
        "Actuator"@en ;
    rdfs:subClassOf bn:Device .

bn:allocatedTo a owl:ObjectProperty ;
    rdfs:domain bn:Function ;
    rdfs:range bn:Ecu .

bn:belongsToModule a owl:ObjectProperty ;
    rdfs:comment "Wire, Connection or Connector is part of a module (KBL: Controlled_components)."@en ;
    rdfs:range bn:Module .

bn:carriesSignal a owl:ObjectProperty ;
    rdfs:domain bn:Connection ;
    rdfs:range bn:Signal .

bn:colour a owl:DatatypeProperty ;
    rdfs:domain bn:Wire ;
    rdfs:range xsd:string .

bn:consumedBy a owl:ObjectProperty ;
    rdfs:domain bn:Signal ;
    rdfs:range bn:Device .

bn:coreOf a owl:ObjectProperty ;
    rdfs:comment "Ader eines mehradrigen Kabels (KBL: Core_occurrence)."@de ;
    rdfs:domain bn:Wire ;
    rdfs:range bn:Wire .

bn:crossSectionMm2 a owl:DatatypeProperty ;
    rdfs:domain bn:Wire ;
    rdfs:range xsd:decimal .

bn:fromContact a owl:ObjectProperty ;
    rdfs:domain bn:Connection ;
    rdfs:range bn:ContactPoint .

bn:hasConnector a owl:ObjectProperty ;
    rdfs:domain bn:Harness ;
    rdfs:range bn:Connector .

bn:hasContactPoint a owl:ObjectProperty ;
    rdfs:domain bn:Connector ;
    rdfs:range bn:ContactPoint .

bn:includesModule a owl:ObjectProperty ;
    rdfs:domain bn:Configuration ;
    rdfs:range bn:Module .

bn:lengthMm a owl:DatatypeProperty ;
    rdfs:domain bn:Wire ;
    rdfs:range xsd:integer .

bn:optionCode a owl:DatatypeProperty ;
    rdfs:comment "Ausstattungsregel des Moduls, z. B. PR-Nummern-Ausdruck (KBL: Logistic_control_information)."@de ;
    rdfs:domain bn:Module ;
    rdfs:range xsd:string .

bn:partNumber a owl:DatatypeProperty ;
    rdfs:range xsd:string .

bn:pluggedInto a owl:ObjectProperty ;
    rdfs:domain bn:Connector ;
    rdfs:range bn:Device .

bn:providedBy a owl:ObjectProperty ;
    rdfs:domain bn:Signal ;
    rdfs:range bn:Device .

bn:realisedBy a owl:ObjectProperty ;
    rdfs:domain bn:Connection ;
    rdfs:range bn:Wire .

bn:requiredCrossSectionMm2 a owl:DatatypeProperty ;
    rdfs:domain bn:Signal ;
    rdfs:range xsd:decimal .

bn:requiresModule a owl:ObjectProperty ;
    rdfs:domain bn:Function ;
    rdfs:range bn:Module .

bn:signalName a owl:DatatypeProperty ;
    rdfs:domain bn:Signal ;
    rdfs:range xsd:string .

bn:sourceSystem a owl:DatatypeProperty ;
    rdfs:range xsd:string .

bn:toContact a owl:ObjectProperty ;
    rdfs:domain bn:Connection ;
    rdfs:range bn:ContactPoint .

bn:usesSignal a owl:ObjectProperty ;
    rdfs:domain bn:Function ;
    rdfs:range bn:Signal .

